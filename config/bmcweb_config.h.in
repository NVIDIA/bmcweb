#pragma once
#include <array>
#include <cstdint>
#include <string_view>

/*
 Meson file (config/meson.build) is used to populate all the features flags
 and compile time variables under the macro *BMCWEB_OPTIONS*.
 It's required to add the features and options under feature_options_string,
 int_options_string or string_options_string.
*/

// clang-format off
// NOLINTBEGIN(readability-identifier-naming)

@BMCWEB_OPTIONS@

constexpr std::string_view BMCWEB_FW_UUID_MAPPING_JSON = @FW_UUID_MAPPING_JSON@;


constexpr std::string_view PLATFORMSYSTEMDESCRIPTION = @PLATFORM_SYSTEM_DESCRIPTION@;
constexpr std::string_view PLATFORMMETRICSID = @PLATFORM_METRICS_ID@;
constexpr std::string_view PLATFORMDEVICEPREFIX = @PLATFORM_DEVICE_PREFIX@;
constexpr std::string_view PLATFORMNETWORKADAPTER = @PLATFORM_NETWORK_ADAPTER@;
constexpr std::string_view PLATFORMCHASSISNAME = @PLATFORM_CHASSIS_NAME@;

constexpr std::string_view HOSTIFACECHANNEL = @HOST_IFACE_CHANNEL@;
constexpr std::string_view FWUUIDMAPPINGJSON = @FW_UUID_MAPPING_JSON@;

constexpr std::string_view NETWORKADAPTERPREFIX = @NETWORK_ADAPTER_PREFIX@;
constexpr std::string_view NETWORKADAPTERLINKPREFIX = @NETWORK_ADAPTER_LINK_PREFIX@;


constexpr const char* platformGpuNamePrefix = @PLATFORM_GPU_NAME_PREFIX@;
constexpr const int mfgTestTimeout = @MFG_TEST_TIMEOUT@;
constexpr const char* redfishAggregationPrefix = @REDFISH_AGGREGATION_PREFIX@;
// NOLINTEND(readability-identifier-naming)
// clang-format on
