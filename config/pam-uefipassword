#%PAM-1.0
#
# PAM service for the BIOS (UEFI) ArmBios password, used by Redfish
# Bios.ChangePassword. Deliberately does not include common-password: that
# stack writes sha512 and runs pwquality/pwhistory/ipmisave, while the BIOS
# password must be a plain yescrypt ("$y$j9T$<salt>$<hash>") /etc/shadow entry
# that nvidia-ipmi-oem's Get/Set BIOS Password commands read and write.

auth     required pam_unix.so
account  required pam_unix.so
password required pam_unix.so yescrypt
