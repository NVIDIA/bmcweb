      <EntityType Name="NvidiaSwitchUPhyRecoveryMode" BaseType="NvidiaSwitchUPhyRecoveryMode.NvidiaSwitchUPhyRecoveryMode">
        <Property Name="Actions" Type="NvidiaSwitchUPhyRecoveryMode.v1_0_0.Actions" Nullable="false">
          <Annotation Term="OData.Description" String="The available actions for this resource."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain the available actions for this resource."/>
        </Property>
        <Property Name="UPhyRecoveryMode" Type="NvidiaSwitchUPhyRecoveryMode.v1_0_0.UPhyRecoveryMode">
          <Annotation Term="OData.Permissions" EnumMember="OData.Permission/ReadWrite"/>
          <Annotation Term="OData.Description" String="The Universal PHY (UPhy) mode of the switch."/>
          <Annotation Term="OData.LongDescription" String="This property shall contain the UPhy recovery mode of the switch.  Universal PHY (UPhy) is NVIDIA's high-speed SerDes physical layer used by the switch's links.  When `Enabled`, the link uses UPhy recovery behavior to attempt PHY-level recovery before fully dropping the link, improving resiliency to recoverable physical-layer errors.  When `Disabled`, that recovery behavior is not used, so the link follows the normal link-down path instead of attempting in-place PHY recovery.  On the active resource, this property shall be read-only and reflect the currently effective mode.  A client shall PATCH this property on the settings resource to `Enabled` or `Disabled`, or use the `ResetToDefaults` action to restore the default.  The change shall take effect on the next link toggle."/>
        </Property>
      </EntityType>
      <EnumType Name="UPhyRecoveryMode">
        <Member Name="Enabled">
          <Annotation Term="OData.Description" String="UPhy recovery mode is enabled."/>
          <Annotation Term="OData.LongDescription" String="This value shall indicate that UPhy recovery mode is enabled."/>
        </Member>
        <Member Name="Disabled">
          <Annotation Term="OData.Description" String="UPhy recovery mode is disabled."/>
          <Annotation Term="OData.LongDescription" String="This value shall indicate that UPhy recovery mode is disabled."/>
        </Member>
      </EnumType>
