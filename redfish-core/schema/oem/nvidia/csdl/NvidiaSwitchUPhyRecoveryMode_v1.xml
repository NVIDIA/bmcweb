    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="NvidiaSwitchUPhyRecoveryMode">
      <Annotation Term="Redfish.OwningEntity" String="NVIDIA"/>
      <EntityType Name="NvidiaSwitchUPhyRecoveryMode" BaseType="Resource.v1_0_0.Resource" Abstract="true">
        <Annotation Term="OData.Description" String="This is the schema definition for the UPhy recovery mode of a switch."/>
        <Annotation Term="OData.LongDescription" String="This resource shall represent the enable or disable Universal PHY (UPhy) mode of a switch.  Pending mode changes are applied through the associated settings resource referenced by the `@Redfish.Settings` annotation and take effect on the next link toggle."/>
        <Annotation Term="OData.AdditionalProperties" Bool="false"/>
        <Annotation Term="Capabilities.InsertRestrictions">
          <Record>
            <PropertyValue Property="Insertable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="Capabilities.UpdateRestrictions">
          <Record>
            <PropertyValue Property="Updatable" Bool="true"/>
            <Annotation Term="OData.Description" String="The UPhy recovery mode is changed by a PATCH on the associated settings resource; the new value takes effect on the next link toggle."/>
          </Record>
        </Annotation>
        <Annotation Term="Capabilities.DeleteRestrictions">
          <Record>
            <PropertyValue Property="Deletable" Bool="false"/>
          </Record>
        </Annotation>
        <Annotation Term="Redfish.Uris">
          <Collection>
            <String>/redfish/v1/Fabrics/{FabricId}/Switches/{SwitchId}/Oem/Nvidia/UPhyRecoveryMode</String>
          </Collection>
        </Annotation>
      </EntityType>
      <Action Name="ResetToDefaults" IsBound="true">
        <Annotation Term="OData.Description" String="Reset the UPhy recovery mode to the default."/>
        <Annotation Term="OData.LongDescription" String="This action shall request the default UPhy recovery mode.  The resolved pending mode shall be reported in the settings resource and shall take effect on the next link toggle."/>
        <Parameter Name="NvidiaSwitchUPhyRecoveryMode" Type="NvidiaSwitchUPhyRecoveryMode.v1_0_0.Actions"/>
