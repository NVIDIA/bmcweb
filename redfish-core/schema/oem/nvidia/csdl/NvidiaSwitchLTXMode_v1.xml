      <Annotation Term="Redfish.OwningEntity" String="NVIDIA"/>
      <EntityType Name="NvidiaSwitchLTXMode" BaseType="Resource.v1_0_0.Resource" Abstract="true">
        <Annotation Term="OData.Description" String="This is the schema definition for the LTX mode of a switch."/>
        <Annotation Term="OData.LongDescription" String="This resource shall represent the enable or disable Link Training eXtended (LTX) mode of a switch.  Pending mode changes are applied through the associated settings resource referenced by the `@Redfish.Settings` annotation and take effect on the next link toggle."/>
